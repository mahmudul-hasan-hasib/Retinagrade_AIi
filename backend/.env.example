# RetinaGrade AI - backend environment template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed; this file is the only version that is tracked.
#
#   copy .env.example .env

# --- Server ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# --- Preprocessing overrides ---
# CFP image size. The CFP checkpoint (EfficientNetB0_CFP_final.pth) stores no
# preprocessing config at all - no image size, no normalization, no colour mode
# (verified by dumping every top-level key). The CFP size is therefore an
# assumption, and 224 is used by default.
#
# Set this ONLY if you learn the real CFP training resolution. It changes
# inference input size only; it never touches the weights. Preprocessing still
# reports itself as unverified when this is set.
# UWF is deliberately not overridable: its 512 px size IS recorded in its
# checkpoint and always wins.
#CFP_IMAGE_SIZE=224

# --- Gemini (optional) - AI-generated explanation for POST /explain ---
# Leave GEMINI_API_KEY empty to disable /explain. It will then answer
# 503 gemini_not_configured; /predict and /gradcam are unaffected.
# The key is read on the server only. It is never sent to the frontend, never
# logged, and never returned in any response.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any model that supports plain text generation. Flash tier is right for this.
GEMINI_MODEL=gemini-2.5-flash
# Optional tuning. Omit to use the defaults in services/gemini.py.
#GEMINI_TIMEOUT_SECONDS=20
#GEMINI_MAX_OUTPUT_TOKENS=700
#GEMINI_TEMPERATURE=0.2
