# RetinaGrade AI - frontend environment template.
#
# Copy to `frontend/.env` for local development:
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# `.env` is gitignored and must never be committed. This file is the only
# version of it that is tracked, and it contains no secrets - the value below is
# a localhost address.
#
# Vite reads `VITE_*` variables at BUILD time and inlines them into the bundle,
# so production builds must set this variable before `npm run build` (in Render:
# the Static site's environment, referenced from render.yaml as VITE_API_URL).
#
# Set it to the deployed backend's public URL, e.g.
#   VITE_API_URL=https://retinagrade-api.onrender.com

VITE_API_URL=http://localhost:8000